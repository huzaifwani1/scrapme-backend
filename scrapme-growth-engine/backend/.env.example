# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4500

# ── MongoDB ─────────────────────────────────────────────────
# Use a SEPARATE database for the Growth Engine — never the production ScrapMe DB.
# GROWTH_ENGINE_MONGO_URI takes precedence. MONGODB_URI is retained as a
# backwards-compatible fallback during the Phase 2 transition.
GROWTH_ENGINE_MONGO_URI=mongodb://localhost:27017/scrapme_growth_engine
MONGODB_URI=mongodb://localhost:27017/scrapme_growth_engine

# Existing ScrapMe transaction database. The integration layer opens this
# connection for reads only; use database credentials with the MongoDB read role.
SCRAPME_MONGO_URI=

# Set true to inspect source records and report planned changes without writing
# to either database. This should be enabled before a first production sync.
DRY_RUN=true

# Optional internal endpoint token. Required for the sync endpoint in production.
INTEGRATION_SYNC_TOKEN=

# ── Customer Segmentation ────────────────────────────────────
# Defaults: 14, 30, 90, and 10000 respectively. Values must be positive.
NEW_CUSTOMER_DAYS=14
INACTIVE_DAYS=30
DORMANT_DAYS=90
HIGH_VALUE_REVENUE_THRESHOLD=10000

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_string
JWT_EXPIRES_IN=7d

# ── ScrapMe Integration ────────────────────────────────────
# Base URL of the ScrapMe production API (read-only access)
SCRAPME_API_BASE_URL=https://api.scrapme.in
SCRAPME_API_KEY=

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
